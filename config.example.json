{
  "listen_host": "127.0.0.1",
  "listen_port": 8899,
  "blocklists": ["data/blocklist.txt"],
  "whitelists": ["data/whitelist.txt"],
  "compatibility_allowlist": [
    "youtube.com",
    "youtu.be",
    "ytimg.com",
    "googlevideo.com",
    "youtubei.googleapis.com",
    "youtube.googleapis.com",
    "youtube-nocookie.com"
  ],
  "connect_timeout_seconds": 10,
  "log_allowed": false,
  "dashboard_enabled": true,
  "dashboard_host": "127.0.0.1",
  "dashboard_port": 8900,
  "stats_file": "data/stats.json",
  "remote_cache_dir": "data/remote",
  "update_on_start": true,
  "update_interval_hours": 24,
  "remote_download_timeout_seconds": 20,

  "browser_companion": {
    "auto_detect": true,
    "auto_install": true,
    "package_dir": "data/browser",
    "managed_policy_install": false,

    "chrome_extension_id": null,
    "chrome_update_url": "https://clients2.google.com/service/update2/crx",

    "edge_extension_id": null,
    "edge_update_url": "https://edge.microsoft.com/extensionwebstorebase/v1/crx",

    "chromium_extension_id": null,
    "chromium_update_url": "https://clients2.google.com/service/update2/crx",

    "firefox_extension_id": "qproxy-youtube@qproxy.local",
    "firefox_signed_xpi": null
  },

  "remote_blocklists": [
    {
      "name": "EasyList",
      "url": "https://easylist.to/easylist/easylist.txt",
      "category": "ad",
      "filename": "easylist.txt"
    },
    {
      "name": "EasyPrivacy",
      "url": "https://easylist.to/easylist/easyprivacy.txt",
      "category": "tracker",
      "filename": "easyprivacy.txt"
    }
  ]
}
