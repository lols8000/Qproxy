{
  "manifest_version": 3,
  "name": "Qproxy YouTube Companion",
  "version": "0.2.0",
  "description": "Qproxy no navegador: bloqueio de URLs de anúncios por regras atualizadas, sem alterar a reprodução de vídeos.",
  "content_scripts": [
    {
      "matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "qproxy-youtube@qproxy.local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "declarativeNetRequest",
    "alarms"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "youtube_network_ads",
        "enabled": true,
        "path": "network_rules.json"
      }
    ]
  },
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  }
}
