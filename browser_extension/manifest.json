{
  "manifest_version": 3,
  "name": "Qproxy YouTube Companion",
  "version": "0.2.1",
  "description": "Qproxy YouTube Companion: filtros nativos e diagnóstico visível no navegador, sem modificar a velocidade do vídeo.",
  "content_scripts": [
    {
      "matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "qproxy-youtube@qproxy.local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "declarativeNetRequest",
    "alarms",
    "storage",
    "declarativeNetRequestFeedback"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "youtube_network_ads",
        "enabled": true,
        "path": "network_rules.json"
      }
    ]
  },
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://127.0.0.1:8900"
  },
  "action": {
    "default_title": "Qproxy · Verificar bloqueio",
    "default_popup": "popup.html"
  }
}
