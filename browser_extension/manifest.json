{
  "manifest_version": 3,
  "name": "Qproxy YouTube Companion",
  "version": "0.1.2",
  "description": "Complemento do Qproxy para reduzir anúncios e promoções dentro do YouTube sem bloquear os domínios de vídeo.",
  "content_scripts": [
    {
      "matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "qproxy-youtube@qproxy.local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "youtube_network_ads",
        "enabled": true,
        "path": "network_rules.json"
      }
    ]
  }
}
